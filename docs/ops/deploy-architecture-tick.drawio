        <mxCell id="p1" value="&lt;b&gt;运维面板 · /schedule&lt;/b&gt;&lt;br&gt;&lt;font color='#5a5a5a'&gt;四行表：时刻 / 动作 / 参数 / 开关&lt;/font&gt;&lt;br&gt;&lt;font color='#5a5a5a'&gt;127.0.0.1:8780，Tailscale 进&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="220" y="110" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p2" value="&lt;b&gt;POST /api/jobs/config&lt;/b&gt;&lt;br&gt;&lt;font color='#5a5a5a'&gt;CRON_SECRET 鉴权，只此一条写路径&lt;/font&gt;&lt;br&gt;&lt;font color='#5a5a5a'&gt;校验 HH:MM / slot 白名单 / 至少一条开&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="530" y="110" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p3" value="&lt;b&gt;KV · job_schedule&lt;/b&gt;&lt;br&gt;&lt;font color='#5a5a5a'&gt;一份 JSON，改完 5 分钟内生效&lt;/font&gt;&lt;br&gt;&lt;font color='#5a5a5a'&gt;同时留 job_schedule_prev 供回滚&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="840" y="110" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p4" value="&lt;b&gt;凭据仍在原处&lt;/b&gt;&lt;br&gt;&lt;font color='#5a5a5a'&gt;控制台 env / GitHub Secrets&lt;/font&gt;&lt;br&gt;&lt;font color='#5a5a5a'&gt;面板只做一致性体检，不代管&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#f5f5f5;strokeColor=#b85450;dashed=1;fontSize=11;fontColor=#777777;" vertex="1" parent="1">
          <mxGeometry x="1150" y="110" width="280" height="100" as="geometry" />
        </mxCell>

        <mxCell id="s1" value="&lt;b&gt;EdgeOne Schedules × 1&lt;/b&gt;&lt;br&gt;&lt;font color='#5a5a5a'&gt;*/5 * * * * · Asia/Shanghai&lt;/font&gt;&lt;br&gt;&lt;font color='#5a5a5a'&gt;payload 为空，无 job / slot / nonce&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="220" y="272" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="&lt;b&gt;POST /api/jobs/tick&lt;/b&gt;&lt;br&gt;&lt;font color='#5a5a5a'&gt;读表 → 算 CST 时分 → 命中才派发&lt;/font&gt;&lt;br&gt;&lt;font color='#5a5a5a'&gt;每跳写 job_tick_last 心跳&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="530" y="272" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="&lt;b&gt;POST /api/jobs/dispatch&lt;/b&gt;&lt;br&gt;&lt;font color='#5a5a5a'&gt;保留：面板手动触发 / 当天补发&lt;/font&gt;&lt;br&gt;&lt;font color='#5a5a5a'&gt;只收 CRON_SECRET，不再认 nonce&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="840" y="272" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="&lt;b&gt;GitHub API&lt;/b&gt;&lt;br&gt;&lt;font color='#5a5a5a'&gt;workflow_dispatch · PAT&lt;/font&gt;&lt;br&gt;&lt;font color='#5a5a5a'&gt;refresh.yml / broadcast.yml&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1150" y="272" width="280" height="100" as="geometry" />
        </mxCell>

        <mxCell id="c1" value="&lt;b&gt;refresh.yml&lt;/b&gt;&lt;br&gt;&lt;font color='#5a5a5a'&gt;07:50 / 09:40 / 14:30 三抓&lt;/font&gt;&lt;br&gt;&lt;font color='#5a5a5a'&gt;scrape → 覆盖率门禁 → 回写&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
