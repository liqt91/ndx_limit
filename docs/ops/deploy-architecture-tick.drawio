        </mxCell>

        <mxCell id="o1" value="&lt;b&gt;KV · job_* 账本&lt;/b&gt;&lt;br&gt;&lt;font color='#5a5a5a'&gt;job_sent_&lt;job&gt;_&lt;slot&gt;_&lt;日&gt; 闸键&lt;/font&gt;&lt;br&gt;&lt;font color='#5a5a5a'&gt;job_tick_last / job_events&lt;/font&gt;&lt;br&gt;&lt;font color='#5a5a5a'&gt;job_rejected_&lt;日&gt; 拒绝计数&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
