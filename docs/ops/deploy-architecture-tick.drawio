        <mxCell id="c2" value="&lt;b&gt;天天基金&lt;/b&gt;&lt;br&gt;&lt;font color='#5a5a5a'&gt;56 份额详情页 + 全量快照&lt;/font&gt;&lt;br&gt;&lt;font color='#5a5a5a'&gt;快照只作对账 / 兜底 / 找缺口&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="530" y="434" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="&lt;b&gt;data/*.json&lt;/b&gt;&lt;br&gt;&lt;font color='#5a5a5a'&gt;history / funds / fund-meta&lt;/font&gt;&lt;br&gt;&lt;font color='#5a5a5a'&gt;announcements 解释「为什么变了」&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="840" y="434" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="&lt;b&gt;Pages 构建 → 站点&lt;/b&gt;&lt;br&gt;&lt;font color='#5a5a5a'&gt;push 自动触发，500 次/月&lt;/font&gt;&lt;br&gt;&lt;font color='#5a5a5a'&gt;ndx.liqt91.top&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1150" y="434" width="280" height="100" as="geometry" />
        </mxCell>

        <mxCell id="b1" value="&lt;b&gt;broadcast.yml&lt;/b&gt;&lt;br&gt;&lt;font color='#5a5a5a'&gt;14:45 · edition 由配置给&lt;/font&gt;&lt;br&gt;&lt;font color='#5a5a5a'&gt;不再需要手工传 inputs&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="220" y="596" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="b2" value="&lt;b&gt;check-freshness&lt;/b&gt;&lt;br&gt;&lt;font color='#5a5a5a'&gt;数据非今日 → exit 2，一封不发&lt;/font&gt;&lt;br&gt;&lt;font color='#5a5a5a'&gt;休市日置 skip，不刷空邮件&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="530" y="596" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="b3" value="&lt;b&gt;Brevo SMTP&lt;/b&gt;&lt;br&gt;&lt;font color='#5a5a5a'&gt;300 封/天免费额度&lt;/font&gt;&lt;br&gt;&lt;font color='#5a5a5a'&gt;订阅者破 300 才碰天花板&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
