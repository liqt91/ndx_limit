        </mxCell>
        <mxCell id="b4" value="&lt;b&gt;订阅者&lt;/b&gt;&lt;br&gt;&lt;font color='#5a5a5a'&gt;名单来自 KV，经 /api/subscribers&lt;/font&gt;&lt;br&gt;&lt;font color='#5a5a5a'&gt;退订 token 算法只在 unsub.mjs&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
