        <mxCell id="kv" value="&lt;b&gt;EdgeOne KV · SUBS_KV&lt;/b&gt;&lt;br&gt;&lt;font color='#5a5a5a'&gt;最终一致 ≤60s · 1GB&lt;/font&gt;&lt;br&gt;sub_{sha256} 订阅名单&lt;br&gt;job_sent_* 每日每时点闸&lt;br&gt;job_events 事件流水 ≤50" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
