        </mxCell>

        <mxCell id="st" value="&lt;b&gt;GET /api/jobs/status&lt;/b&gt;&lt;br&gt;&lt;font color='#5a5a5a'&gt;只读 · 无鉴权 · 无 secret&lt;/font&gt;&lt;br&gt;四跳状态 + 事件流" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="340" y="590" width="210" height="90" as="geometry" />
