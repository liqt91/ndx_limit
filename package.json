{
  "name": "nasdaq-daily",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "纳指开门日报 - 静态复刻版 (Astro SSG)",
  "scripts": {
    "dev": "astro dev",
    "scrape": "node scripts/scrape.mjs",
    "import:history": "node scripts/import-history.mjs",
    "check:data": "node scripts/check-freshness.mjs",
    "check:index": "node scripts/check-index-isolation.mjs",
 "check:broadcast": "node scripts/check-broadcast.mjs",
    "calendar:build": "node scripts/build-us-calendar.mjs",
