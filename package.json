{
  "name": "nasdaq-daily",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "纳指开门日报 - 静态复刻版 (Astro SSG)",
  "scripts": {
    "dev": "astro dev",
    "scrape": "node scripts/scrape.mjs",
    "check:data": "node scripts/check-freshness.mjs",
    "calendar:build": "node scripts/build-us-calendar.mjs",
    "calendar:check": "node scripts/build-us-calendar.mjs --check && node scripts/check-cn-holidays.mjs",
    "build": "astro build",
    "ci:build": "node scripts/scrape.mjs && astro build",
    "preview": "astro preview",
    "send": "node scripts/send.mjs",
    "send:dry": "node scripts/send.mjs --dry-run"
  },
  "dependencies": {
    "astro": "^5.0.0",
    "nodemailer": "^10.1.7"
  }
}
