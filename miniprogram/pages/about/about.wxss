/* 关于页 */

.about-list { border-top: 1px solid var(--rule); }
.about-row {
  display: flex;
  gap: 14px;
  padding: 12px 0;
  border-bottom: 1px solid var(--rule);
}
.about-k {
  flex: none;
  width: 68px;
  font-family: var(--mono);
  font-size: 12px;
  color: var(--ink-3);
  letter-spacing: 0.02em;
  line-height: 1.8;
}
.about-v {
  flex: 1;
  min-width: 0;
  font-size: 13.5px;
  color: var(--ink-2);
  line-height: 1.8;
}
