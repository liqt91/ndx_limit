# 依赖
node_modules/

# 构建产物（由 astro build 生成，CI / 本地预览时重建）
dist/
.astro/

# WorkBuddy 项目内部数据（非源码）
.workbuddy/

# 系统 / 日志
.DS_Store
*.log
npm-debug.log*

# 订阅者名单（含个人邮箱，绝不入库；通过国内表单/私有地址提供）
data/subscribers*.json
data/subscribers*.csv
data/*.subscribers.*
subscribers*.csv

# IDE 配置（个人本地，不入库）
.vscode/

# 数据备份（history.json 抓取/清理时的临时副本，非源码）
*.bak
data/*.bak*
