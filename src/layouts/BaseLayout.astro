---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';

interface Props {
  title: string;
  description?: string;
  /** 站名。多指数分站后，标普500 页面不该叫「纳指开门日报」 */
  siteName?: string;
  /** 添加到桌面时的短名（iOS 会截断长标题） */
  shortName?: string;
  /** 当前指数（用于导航高亮）。省略 = 按路径推断；显式传 null = 共用页，两个指数项都不高亮 */
  navKey?: string | null;
}
const {
  title,
  // 共用页（我的基金 / 订阅 / 详情外）没有指数身份，默认值必须是中性的：
  // 写死「纳指开门日报」会让标普500 用户在自己的页面上看到别人的站名。
  description = '每天告诉你，QDII 场外申购份额今天能不能买、能买多少。',
  siteName = 'QDII 开门日报',
  shortName = 'QDII 日报',
  navKey,
} = Astro.props;

const year = new Date().getFullYear();
// 分享卡片图：绝对 URL（微信、Telegram 都按绝对地址抓 og:image）
const ogImage = new URL('/og.png', Astro.site);
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- 分享卡片：没有 OG 标签时，微信与各家 IM 里分享出去就是一条裸链接，
         标题靠客户端猜、也没有缩略图。og:url 用 canonical，避免带查询串的地址各发各的。 -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${siteName}：标题与 21 格额度热力`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- PWA：安卓可「添加到桌面」，独立图标启动 -->
    <link rel="canonical" href={canonical} />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#faf9f6" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content={shortName} />
  </head>
  <body>
    <div class="frame">
      <SiteHeader brand={siteName} navKey={navKey} />
      <main class="wrap">
        <slot />
      </main>
      <footer class="foot">
        <p class="foot-cal">只展示交易日。美股交易日信息来源于节假日规则，规则外休市（极端天气、技术故障）可能当作交易日展示</p>
        <p class="foot-disc">只统计场外申购份额（不含场内 ETF）。每天盘前 7:50、早盘 9:40、收盘前 14:30 各抓一次</p>
        <p class="foot-disc">实际可买额度请以下单页面为准，盘中可能调整；数据抓取自天天基金等公开数据</p>
        <p class="foot-disc">仅陈述客观信息，不构成投资建议</p>
        <div class="foot-grid">
          <div class="foot-brand">
            © {year} {siteName}
          </div>
          <!-- 备案号位：拿到号码后把文字替换为「京ICP备XXXXXXXX号-X」，
               改成指向 https://beian.miit.gov.cn 的链接，颜色类换掉（ghost → ink-3） -->
          <div class="foot-icp">备案号待补充</div>
        </div>
      </footer>
    </div>

    <!-- 离线兜底：断网时至少能打开上次抓到的那一版 -->
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', function () {
          navigator.serviceWorker.register('/sw.js').catch(function () {});
        });
      }
    </script>
  </body>
</html>
