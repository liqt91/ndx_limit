---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import { loadTodaySnapshot } from '../data/loader';

interface Props {
  title: string;
  description?: string;
}
const {
  title,
  description = '每天早上 8 点，告诉你今天纳斯达克基金还能不能买、能买多少。',
} = Astro.props;

const snap = loadTodaySnapshot();
const dataDate = snap.snapDate;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <div class="frame">
      <SiteHeader />
      <main class="wrap">
        <slot />
      </main>
      <footer class="foot">
        <div class="foot-cta"><a href="/subscribe">订阅每日日报 →</a></div>
        <p class="foot-disc">
          数据来自基金公司公开公告与公开基金数据（代销额度抓取自天天基金），可能存在延迟或误差。实际可买额度请以下单页面为准。以上仅陈述客观信息，不构成投资建议。
        </p>
        <div class="foot-grid">
          <div class="foot-brand">
            © {year} 纳指开门日报<br />
            数据日期 {dataDate}
          </div>
          <div class="foot-col">
            <div class="foot-col-h">数据</div>
            <span>抓取自天天基金</span>
            <span>每日 08:00 更新</span>
            <span>静态生成，无服务器</span>
          </div>
          <div class="foot-col">
            <div class="foot-col-h">站内</div>
            <a href="/">今日</a>
            <a href="/daily">历史</a>
            <a href="/subscribe">订阅</a>
          </div>
        </div>
      </footer>
    </div>
  </body>
</html>
