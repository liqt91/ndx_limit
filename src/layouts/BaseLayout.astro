---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import { indexSlug } from '../data/loader';

interface Props {
  title: string;
  description?: string;
  /** 站名。多指数分站后，标普500 页面不该叫「纳指开门日报」 */
  siteName?: string;
  /** 添加到桌面时的短名（iOS 会截断长标题） */
  shortName?: string;
  /** 当前指数（用于导航高亮）。省略 = 按路径推断；显式传 null = 共用页，两个指数项都不高亮 */
  navKey?: string | null;
  /** 页面所属指数（用于分站纸色）。省略/null = 共用页，保持中性纸 */
  indexKey?: string | null;
  /**
   * 顶栏站名。默认跟 siteName。共用页要单独传——那里站标已经是 QDII 字标，
   * 站名再以「QDII」开头就成了「[QDII] QDII 开门日报」，同一个词读两遍。
   */
  headerBrand?: string;
}
const {
  title,
  // 共用页（我的基金 / 订阅 / 详情外）没有指数身份，默认值必须是中性的：
  // 写死「纳指开门日报」会让标普500 用户在自己的页面上看到别人的站名。
  description = '每天告诉你，QDII 场外申购份额今天能不能买、能买多少。',
  siteName = 'QDII 开门日报',
  headerBrand,
  shortName = 'QDII 日报',
  navKey,
  indexKey,
} = Astro.props;

// 分站纸色。data-board 是 <html> 上的一个属性，CSS 靠它整页换纸（见 global.css）。
// ★ 不叫 data-index：那个名字在代码里已经有两个含义（FamilyCard 和 /my 的分段都用它存
//   中文指数名），再让 <html> 用同名字段存 ASCII slug，早晚会有人写 [data-index] 时一起选中。
// ★ 与 navKey 分开传，不能从 navKey 推断：共用页 navKey 可能是 null，而「没传」
//   又表示按路径猜——把视觉身份挂在这种三态语义上，迟早会像 2026-10-23 那次
//   aria-current 一样，在共用页上点亮一个板块。
// slug 从 INDEXES.path 推导，避免再多一处「加指数要同步改」的清单。
const indexSlugValue = indexKey ? indexSlug(indexKey) : null;

// 手机浏览器地址栏染色。★ 这三行与 global.css 里 --paper 的三处定义是同一份事实，
//   改了颜色必须两处同改——check:index 会逐字比对，对不上就红。
//   2026-10-23 起两个板块共用一张纸，所以两行同值；仍按 slug 分开写，
//   是为了以后真要拆成两套纸时不用改结构（断言也会一起提醒）。
//   2026-10-26 去掉牛皮纸黄：纸 #f9f0dd → #fcfbf6。
const PAPER: Record<string, string> = { ndx100: '#fcfbf6', sp500: '#fcfbf6' };
const themeColor = (indexSlugValue && PAPER[indexSlugValue]) || '#fcfbf6';

const year = new Date().getFullYear();
// 分享卡片图：绝对 URL（微信、Telegram 都按绝对地址抓 og:image）
const ogImage = new URL('/og.png', Astro.site);
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="zh-CN" data-board={indexSlugValue ?? undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- 分享卡片：没有 OG 标签时，微信与各家 IM 里分享出去就是一条裸链接，
         标题靠客户端猜、也没有缩略图。og:url 用 canonical，避免带查询串的地址各发各的。 -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${siteName}：标题与 21 格额度热力`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- PWA：安卓可「添加到桌面」，独立图标启动 -->
    <link rel="canonical" href={canonical} />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content={themeColor} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content={shortName} />
  </head>
  <body>
    <div class="frame">
      <SiteHeader brand={headerBrand ?? siteName} navKey={navKey} />
      <main class="wrap">
        <slot />
      </main>
      <footer class="foot">
        <p class="foot-cal">只展示交易日。美股交易日信息来源于节假日规则，规则外休市（极端天气、技术故障）可能当作交易日展示</p>
        <p class="foot-disc">只统计场外申购份额（不含场内 ETF）。每天盘前 7:50、早盘 9:40、收盘前 14:30 各抓一次</p>
        <p class="foot-disc">实际可买额度请以下单页面为准，盘中可能调整；数据抓取自天天基金等公开数据</p>
        <p class="foot-disc">仅陈述客观信息，不构成投资建议</p>
        <div class="foot-grid">
          <div class="foot-brand">
            © {year} {siteName}
          </div>
          <!-- 备案号位：拿到号码后把文字替换为「京ICP备XXXXXXXX号-X」，
               改成指向 https://beian.miit.gov.cn 的链接，颜色类换掉（ghost → ink-3） -->
          <div class="foot-icp">备案号待补充</div>
        </div>
      </footer>
    </div>

    <!-- 离线兜底：断网时至少能打开上次抓到的那一版 -->
    <script is:inline>
      // 本地（localhost / 127.0.0.1）不注册 SW，并且把装过的旧 SW 注销掉。
      //
      // 原因：sw.js 对静态资源是缓存优先，本地第一次访问就把 CSS 钉在那份缓存里，
      // 之后改样式永远拿旧的；而页面导航是网络优先，所以 HTML 是新的、CSS 是旧的，
      // 看起来像「改动没生效」。反过来停掉服务器后导航回落缓存，又能打开，
      // 看起来像「服务还在跑」。两头都会让人误判，本地干脆别装。
      var swHost = location.hostname;
      var isLocalHost = swHost === 'localhost' || swHost === '127.0.0.1' || swHost === '[::1]';

      if ('serviceWorker' in navigator) {
        if (isLocalHost) {
          navigator.serviceWorker
            .getRegistrations()
            .then(function (regs) {
              regs.forEach(function (r) {
                r.unregister();
              });
              if (window.caches) {
                caches.keys().then(function (keys) {
                  keys.forEach(function (k) {
                    caches.delete(k);
                  });
                });
              }
            })
            .catch(function () {});
        } else {
          window.addEventListener('load', function () {
            navigator.serviceWorker.register('/sw.js').catch(function () {});
          });
        }
      }
    </script>
  </body>
</html>
