---
import type { DailySummary, DailyChanges, IntradayBlock, BuyableFamily } from '../data/loader';
import type { PurchaseStatus } from '../data/types';
import { STATUS_SHORT } from '../lib/status';
import ChangeList from './ChangeList.astro';

interface Seg {
  label: string; // 纳指100 / 标普500
  summary: DailySummary | null;
  changes: DailyChanges | null;
  /** 邮件第 1 段末尾的抓取时刻说明（最新一天才有，如「10:16 抓取」） */
  dataNote?: string;
  /** 邮件第 3 段：较盘前/日内的盘中变化（最新一天才有） */
  intraday?: IntradayBlock | null;
  /** 邮件最后一段：今日能买的份额清单（代码 + 额度），与正文同一个实现 */
  buyable?: BuyableFamily[];
}
interface DigestDay {
  date: string;
  label: string; // 日期标签，如 10.24 周五
  segs: Seg[]; // [纳指段, 标普段] —— 一封邮件里两个指数同屏
}

interface Props {
  days: DigestDay[];
}

const { days } = Astro.props;

// 变化行两端的状态/额度文案：与首页「今日变化」、邮件日报同一套说法。
const isLimitKind = (k: string) => k.startsWith('limit');
const fmtSide = (s: PurchaseStatus, limit: number | null) =>
  s === 'LIMITED' && limit != null ? `限 ${limit} 元` : STATUS_SHORT[s];
const fmtTotal = (v: number) => v.toLocaleString('en-US');

// 清单按币种分组（人民币在前），与邮件正文的顺序一致；美元份额不并进人民币那一组。
const buyGroups = (fams: BuyableFamily[] | undefined) =>
  [
    { key: 'CNY', label: '人民币' },
    { key: 'USD', label: '美元' },
  ]
    .map((g) => {
      const list = (fams ?? []).filter((f) => f.currency === g.key);
      return { ...g, list, n: list.reduce((a, f) => a + f.shares.length, 0) };
    })
    .filter((g) => g.list.length > 0);
---

{
  days.length === 0 ? (
    <p class="dw-empty">暂无历史日报可展示（本地尚未抓取数据）。</p>
  ) : (
    <div class="dw">
      {days.map((day) => (
        <div class="dw-day">
          <div class="dw-date">
            <span class="dw-dot" />
            {day.label} · 收盘前报
          </div>
          {day.segs.map((seg) => (
            <div class="dw-idx">
              <div class="dw-idx-h">
                <span class="dw-idx-name">{seg.label}</span>
                {seg.summary && (
                  <span class="dw-idx-sum">
                    {seg.summary.opened} 家开门 · 合计 <b>{fmtTotal(seg.summary.total)}</b> 元可投
                    {seg.dataNote && <span class="dw-note">（{seg.dataNote}）</span>}
                  </span>
                )}
              </div>
              {seg.changes ? (
                <>
                  <div class="dw-delta">
                    {seg.changes.changes.length ? (
                      <>较 {seg.changes.prevDate}：{seg.changes.opened} 处开门 · {seg.changes.stopped} 处暂停 · {seg.changes.limitChanged} 处额度变动</>
                    ) : (
                      <>较 {seg.changes.prevDate}：今日无变化，申购状态与额度都和上一交易日一致。</>
                    )}
                  </div>
                  {seg.changes.changes.length > 0 && <ChangeList items={seg.changes.changes} />}
                </>
              ) : (
                !seg.summary && <div class="dw-no-data">暂无数据</div>
              )}
              {seg.intraday && (
                <div class="dw-intraday">
                  <div class="dw-delta dw-delta-intra">
                    <span class="dw-intra-tag">盘中</span>
                    {seg.intraday.prevLabel}：{seg.intraday.changes.length} 处变化
                  </div>
                  {seg.intraday.changes.length > 0 && <ChangeList items={seg.intraday.changes} />}
                </div>
              )}
              {/* 清单是邮件正文最后一段：一家一行，代码 + 额度。读者真正下单要的就是这三个字。
                  ★ 不再另写一套额度文案：amount 由 loader（= digest.mjs）给好，
                    免得「10元 / 10 元 / 限额10元」在页面与信里各说一遍。 */}
              {buyGroups(seg.buyable).map((g) => (
                <div class="dw-buy">
                  <div class="dw-buy-h">今日能买（{g.label}份额 {g.n} 个）</div>
                  {g.list.map((f) => (
                    <div class="dw-buy-row">
                      <span class="dw-buy-name">{f.name}</span>
                      {f.shares.map((s, idx) => (
                        <span class="dw-buy-sh">
                          <i>{s.cls}类</i>
                          <b>{s.code}</b>
                          <em>{s.amount}</em>
                          {/* 分隔点挂在上一份额的尾部：挂在下一份额的开头时，
                              窄屏折行会让新行以「· C类」起头，看着像漏了一截。 */}
                          {idx < f.shares.length - 1 && <span class="dw-buy-sep">·</span>}
                        </span>
                      ))}
                    </div>
                  ))}
                </div>
              ))}
            </div>
          ))}
        </div>
      ))}
    </div>
  )
}
