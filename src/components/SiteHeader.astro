---
// 顶栏。2026-10-23 起站点在 qdii.liqt91.top，两个指数各占一个路径前缀：
//   /ndx100 纳指100、/sp500 标普500；/my、/subscribe、/f/<code> 跨指数共用。
// 导航第一项是指数名而不是「今日」：两个看板长得一样，只有把指数名放进导航，
// 读者才知道自己在看哪一个。
import { INDEXES, NDX, SP500 } from '../data/loader';

interface Props {
  brand?: string;
  /** 当前指数。省略 = 按路径推断；显式 null = 共用页，指数项一律不高亮 */
  navKey?: string | null;
}
const { brand = 'QDII 开门日报', navKey } = Astro.props;

const path = Astro.url.pathname;
// 兼容带与不带尾斜杠两种写法（/ndx100 与 /ndx100/ 都可能出现在外部链接里）
const isCurrent = (p: string) => {
  const bare = p.replace(/\/$/, '');
  return path === p || path === bare || path.startsWith(bare + '/');
};

// 区分「没传」与「显式传 null」：没传才按路径猜。
// 共用页（/my）如果也按路径猜，会落到「纳指」上，于是「纳指」和「我的基金」
// 同时带 aria-current —— 屏幕阅读器会念两个当前页。
const activeKey = navKey === null ? null : (navKey ?? (path.startsWith('/sp500') ? SP500 : NDX));
const brandHref = activeKey === SP500 ? '/sp500/' : '/ndx100/';

// 只列两个指数；INDEXES 里若以后加第三个，导航会自动多一项。
// 标签用短名（纳指 / 标普500）而不是全称「纳斯达克100」：390 宽下 6 个导航项 +
// 品牌名会把「纳斯达克100」压成「纳斯达 / 克100」两行，订阅按钮也竖排。
// 超链接上的名字用 navLabel（「纳指」/「标普」），正文里仍用 short（「标普500」）。
// 两项等长，导航栏才不会因为其中一个突然长一截而错位。
const indexNav = INDEXES.map((i) => ({
  label: i.navLabel,
  href: i.path,
  key: i.key,
}));

// 站标：两种形态，靠「这一页有没有指数身份」分开。
//   有指数身份（/ndx100、/sp500、/f/<code>）→ 方块 + 挖空单字母 N / S；
//   没有指数身份（/my、/subscribe）→ 方块 + 字标 QDII。
// 2026-10-26 用户原话：「纳指、标普还是单字母logo，其他情况用QDII logo，包括我的基金、订阅」。
// ★ 共用页原来是借 N —— 那会说错话：/my 不是纳指页，顶着 N 等于把读者按进了纳指板块。
//   QDII 是站点本身的缩写，两页都成立。
// 两个形态的底色都取 --accent（纳指蓝 / 标普红 / 共用页墨色），字/字形用纸色，
// 所以它读起来是「同一本书的第几卷」，不是两个产品。
// ★ S 用曲线而不是七段式折线：N 本来就全是直线，字母自身该直该曲，不该为了「风格统一」
//   把 S 掰成阶梯（那在 18px 下会读成「5」）。
// ★ S 的笔画比 N 粗 0.3：同样的 stroke-width 下，曲线的墨量看起来比直线少一截，
//   两者并排 N 明显更重。字面高度也压到与 N 齐平（N 是 y 11→24），
//   不然 S 的 overshoot 会让它比邻居高出一头。
const isBoard = activeKey === NDX || activeKey === SP500;
const isSp = activeKey === SP500;
const markPath = isSp
  ? 'M23.5 13.5 C23.5 11.5 21 10.6 17.75 10.6 C14.5 10.6 12 11.6 12 13.8 C12 16 14.2 16.6 17.75 17.2 C21.3 17.8 23.5 18.4 23.5 20.6 C23.5 22.8 21 23.8 17.75 23.8 C14.5 23.8 12 23 12 21'
  : 'M10 11 L10 24 M10 11 L25 24 M25 11 L25 24';
const markStroke = isSp ? 2.9 : 2.6;
---

<header class="site-head">
  <div class="site-head-inner">
    <a class="site-brand" href={brandHref}>
      {isBoard ? (
        <svg class="site-mark" viewBox="0 0 35 35" width="18" height="18" aria-hidden="true" focusable="false">
          <rect x="1" y="1" width="33" height="33" rx="3" />
          <path d={markPath} stroke-width={markStroke} stroke-linecap="square" stroke-linejoin="round" fill="none" />
        </svg>
      ) : (
        <span class="site-mark site-mark-text" aria-hidden="true">QDII</span>
      )}
      <span>{brand}</span>
    </a>
    <nav class="site-nav">
      {indexNav.map((i) => (
        <a href={i.href} aria-current={activeKey === i.key ? 'page' : undefined}>{i.label}</a>
      ))}
      <a href="/my" aria-current={isCurrent('/my') ? 'page' : undefined}>我的基金</a>
      <a class="btn-sub" href="/subscribe">订阅</a>
    </nav>
  </div>
</header>
