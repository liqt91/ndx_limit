---
// 单个月份的交易日历网格。
//
// 只有两档字色：
//   墨色 = 两市都开，今晚可以申购
//   灰色 = 买不到（周末 / A 股假日 / 美股假日 / 覆盖不到）
//
// 为什么不把「为什么买不到」编码成删除线、下划线、色点：格子只有 14px，
// 四种标记必须配一张图例当说明书才看得懂。原因改成悬停时的三行字——
// 第一行日期星期，第二行 A 股，第三行美股，各自带理由。
import type { MonthGrid, DayInfo } from '../data/trading-days';
import { openWord } from '../data/trading-days';

interface Props {
  grid: MonthGrid;
  today: string;
}

const { grid, today } = Astro.props;
const WEEK_HEAD = ['一', '二', '三', '四', '五', '六', '日'];

function cellClass(d: DayInfo, isToday: boolean) {
  const cls = ['cal-d', d.state === 'TRADING' ? 'is-trade' : 'is-off'];
  if (isToday) cls.push('is-today');
  return cls.join(' ');
}
---

<div class="cal-m">
  <div class="cal-m-h">
    <span class="cal-m-t">{grid.label}</span>
    <span class="cal-m-n">
      {grid.unknown ? '未覆盖' : `${grid.tradeCount} 天可申购`}
      {grid.provisional && <span class="cal-m-p" title="该年 A 股放假安排尚未正式公布，按预排口径">预排</span>}
    </span>
  </div>

  {
    grid.unknown ? (
      <p class="cal-empty">该月不在日历覆盖范围，不做判断。</p>
    ) : (
      <div class="cal-m-grid">
        {WEEK_HEAD.map((w) => (
          <span class="cal-w">{w}</span>
        ))}
        {grid.weeks.flat().map((d) =>
          d ? (
            <span class={cellClass(d, d.date === today)} tabindex="0" aria-label={d.title}>
              {d.day}
              <span class="cal-tip" aria-hidden="true">
                <b class="ct-d">
                  {d.md} {d.weekZh}
                </b>
                <span class="ct-r">
                  <i class="ct-k">A 股</i>
                  <b class:list={['ct-v', { 'ct-off': !d.cnOpen }]}>{openWord(d.cnOpen)}</b>
                  <span class="ct-why">· {d.cnReason}</span>
                </span>
                <span class="ct-r">
                  <i class="ct-k">美股</i>
                  <b class:list={['ct-v', { 'ct-off': !d.usOpen }]}>{openWord(d.usOpen)}</b>
                  <span class="ct-why">· {d.usReason}</span>
                </span>
              </span>
            </span>
          ) : (
            <span class="cal-d is-pad" />
          )
        )}
      </div>
    )
  }
</div>
