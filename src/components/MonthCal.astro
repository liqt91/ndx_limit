---
// 单个月份的交易日历网格。
//
// 只用三种视觉信号，避免图例变成说明书：
//   墨色数字   = 两市开市，可申购
//   划掉       = A 股休市（周末更淡，法定假日带删除线）
//   赭色方点   = 美股休市 —— 平台开着也买不到的那几天，唯一需要提前知道的
import type { MonthGrid } from '../data/trading-days';

interface Props {
  grid: MonthGrid;
  today: string;
}

const { grid, today } = Astro.props;
const WEEK_HEAD = ['一', '二', '三', '四', '五', '六', '日'];

function cellClass(state: string, weekend: boolean, isToday: boolean) {
  const cls = ['cal-d'];
  // 周末一律最淡：它们同时也是「两市都不开」，若跟法定假日一样划掉，整张月历会吵得看不清
  if (state === 'UNKNOWN') cls.push('is-unknown');
  else if (weekend) cls.push('is-weekend');
  else if (state === 'TRADING') cls.push('is-trade');
  else if (state === 'US_CLOSED') cls.push('is-us'); // 唯一的高亮：赭色 + 方点
  else cls.push('is-cn'); // 法定假日 / 两市同时休市
  if (isToday) cls.push('is-today');
  return cls.join(' ');
}
---

<div class="cal-m">
  <div class="cal-m-h">
    <span class="cal-m-t">{grid.label}</span>
    <span class="cal-m-n">
      {grid.unknown ? '未覆盖' : `${grid.tradeCount} 天可申购`}
      {grid.provisional && <span class="cal-m-p" title="该年 A 股放假安排尚未正式公布，按预排口径">预排</span>}
    </span>
  </div>

  {
    grid.unknown ? (
      <p class="cal-empty">该月不在日历覆盖范围，不做判断。</p>
    ) : (
      <div class="cal-m-grid">
        {WEEK_HEAD.map((w) => (
          <span class="cal-w">{w}</span>
        ))}
        {grid.weeks.flat().map((d) =>
          d ? (
            <span class={cellClass(d.state, d.weekend, d.date === today)} title={d.title}>
              {d.day}
            </span>
          ) : (
            <span class="cal-d is-pad" />
          )
        )}
      </div>
    )
  }
</div>
