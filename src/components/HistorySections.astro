---
// 指数页底部的「交易日历」（竖向周行，内嵌每日可投额度）。
//
// 2026-10-23 之前「每日快照」是独立的历史页（/ndx100/daily），后来并进来；
// 2026-10-25 先与「交易日历」合并成一张月历，格子塞日期+额度，太密太挤；
// 当天又改为「周历」：每周一行、七格大格子，过去的交易日直接写额度，密度骤降。
//
// 锚点挂在整块上：旧链接 /ndx100/daily 跳到 #history 要落在这节的顶上。
//
// 数据零新增：loadDailySummaries 已按日期给 {opened,total}，做成 Map 按 DayInfo.date 查表；
// 取数窗 60 天，窗口按「最早有数据那周的周一 → 本周」对齐，不渲染空周。
import SectionHead from './SectionHead.astro';
import WeekCal from './WeekCal.astro';
import { loadDailySummaries, getToday } from '../data/loader';
import { weeksAround, mondayOf } from '../data/trading-days';

interface Props {
  indexKey: string;
  /** 交易日历小节编号（接在「今天能买多少」之后） */
  index: string;
}
const { indexKey, index } = Astro.props;

const today = getToday();
const totals = new Map<string, { opened: number; total: number }>();
for (const s of loadDailySummaries(60, indexKey)) {
  totals.set(s.date, { opened: s.opened, total: s.total });
}

// 窗口对齐：从「最早有数据的周一」到「本周」，刚好覆盖全部历史交易日，不渲染空周。
const dates = [...totals.keys()].sort();
const earliest = dates[0] ?? today;
const weeksBack = Math.max(0, Math.ceil((Date.parse(today) - Date.parse(mondayOf(earliest))) / 604800000));
// 最新周置底：远周在上、近周在下、未来一周在最底，按时间正向铺开（旧→新→未来）
const weeks = weeksAround(today, weeksBack, 1);
---

<div id="history">
  <SectionHead index={index} title="交易日历" />
  <WeekCal weeks={weeks} today={today} totals={totals} />
</div>
