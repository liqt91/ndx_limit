---
// 历史页主体。两个指数共用一个组件，只换 indexKey——与 IndexBoard 的分工一致：
// 页面（src/pages/<index>/daily.astro）只声明指数，渲染逻辑全在这里。
//
// 为什么是两条路由而不是一页筛选：历史是**内容页**，/sp500/daily 是可以单独贴给
// 别人的东西（「9 月标普一直是 1 家 20 元」）。单 URL 加 JS 显隐会让分享链接只能
// 给到首页，还会让一个目前零 JS 的页面变成必须跑 JS。切换器（IndexSwitch link 版）
// 在视觉上就是筛选，点一下只换 URL，不换体验。
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHead from '../components/SectionHead.astro';
import TradingCalendar from '../components/TradingCalendar.astro';
import IndexSwitch from '../components/IndexSwitch.astro';
import { loadDailySummaries, getToday, indexMeta } from '../data/loader';

interface Props {
  indexKey: string;
}
const { indexKey } = Astro.props;

const meta = indexMeta(indexKey);
const today = getToday();
const summaries = loadDailySummaries(15, indexKey);
// 最早一天：文案里那句「自 X 起」必须是算出来的，不能手写。
// 手写的版本在标普500 回填 22 天历史后立刻变成假话（原话写的是「从 2026-10-23 开始」）。
const firstDate = summaries.length ? summaries[summaries.length - 1].date : null;
---

<BaseLayout
  title={`历史 - ${meta.brand}`}
  description={`${meta.label}场外 QDII 份额的每日开门家数与可投额度，含交易日历。`}
  siteName={meta.brand}
  shortName={`${meta.short}日报`}
  navKey={indexKey}
>
  <h1 class="section-title">历史</h1>
  <IndexSwitch current={indexKey} mode="link" suffix="/daily" />

  <SectionHead index="01" title="交易日历" aside="上月 · 本月 · 下月" />
  <p class="my-hint">
    交易日历对两个指数通用（都跟美股开市）。下方每日快照按{meta.label}统计{firstDate ? `，自 ${firstDate} 起` : ''}——两个指数的额度各算各的，不相加。
  </p>
  <TradingCalendar today={today} />

  <SectionHead index="02" title={`每日快照 · ${meta.label}`} aside={`最近 ${summaries.length} 个交易日`} />

  {
    summaries.length === 0 ? (
      <p class="empty">{meta.label}还没有历史数据。</p>
    ) : (
      <ul class="daylist">
        {summaries.map((s) => (
          <li class="dayrow">
            <div class="day-main">
              <span class="day-date">{s.label}</span>
              <span class="day-sub">
                <b>{s.opened}</b> 家开门 · 共监控 {s.count} 家（人民币）
              </span>
            </div>
            <div class="day-total">
              {s.total}
              <span class="day-unit">元</span>
            </div>
          </li>
        ))}
      </ul>
    )
  }
</BaseLayout>
