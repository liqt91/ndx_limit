---
// 竖向周历：每周一行，左列标周范围，右 5 格（仅工作日）。
//
// ★ 2026-10-26 第五轮：行高锁定，格子只有两个槽位。
//   第四轮撤掉柱以后，行高变成「谁字数多谁说了算」，实测同一页里桌面 38/48/49、
//   窄屏 38/46.6/53.1 三种高度并存，三个来源：
//     ① 休市格的「休市原因」比交易日多一行；
//     ② 左列周范围在 46px 宽下折成两行（跨月「9.28–10.2」桌面也折）；
//     ③ 「本周」二字写在左列，把那一行顶高 10px。
//   现在：行高＝常量（--wk-h），格子内固定两槽 —— **上行日期、下行结论**
//   （交易日＝额度 / 休市＝原因 / 缺数据＝未收录 / 还没到＝空）。下行一律单行
//   + 省略号，超长（如「美国·马丁·路德·金纪念日」）交给悬停卡说完整。
//   于是任何一格的字数都不再影响行高，也不再影响隔壁行。
//   ★ 「本周」二字 2026-10-26 第五轮删除：它本身就是③。本周仍由三重无高度标记
//     指认 —— 行初 2px 墨书签 + 极淡中性底 + 周范围用最深的墨/加粗（其余周 ink-2）。
//
// ★ 2026-10-26 第四轮：日历不再用图形编码额度。
//   前一天还是「12px 数字 + 一根柱（高度 ∝ 当日额度）」，用户当天就提了：
//   「交易不用热力图的展现形式，只是区分交易日和非交易日呢？」
//   撤掉的理由：① 格子 50–90px 宽、柱区 28px，纳指 9 个额度值只落成 7 档，
//   图形分辨率还不如紧挨着的数字；② 柱高抢走了「开不开门」的对比 ——
//   那才是日历该回答的问题。
//   现在每格只写两件事：**日期**（开市=深墨加粗 / 休市=浅灰）与**当日额度**（数字）
//   或**休市原因**（文字）。额度仍是可比的（等宽数字、同一条左基线），但不画形状。
//   试过给交易日整格填 --heat-1：一眼能扫出开不开门，但 22 格绿块成了色墙，已回退。
//
// 未来一周不再排进网格：那 5 格说的都是同一句「能买」，而真正想知道的
// 「下次哪天买不了」（2026-11-26 感恩节，31 天后）落在窗口外。现在表下用一行
// 文字回答（buyOutlook），网格只画已经发生过的日子。
// 于是「未来」只剩本周内那几格：只有浅灰日期，与「过去但没抓到数据」
// （写「未收录」/「待更新」）区分开。
import type { WeekGrid } from '../data/trading-days';
import { buyOutlook, mondayOf, offReason, openWord } from '../data/trading-days';

const { weeks, today, totals } = Astro.props;
// 含 today 的那一周（today 是周日时，这一周的周一仍落在当前周）= 本周，单独标出
const curMonday = mondayOf(today);
// 表下那一行：还能连着买几天、下次哪天买不了
const outlook = buyOutlook(today);

interface Props {
  weeks: WeekGrid[];
  today: string;
  /** 日期 → 当日聚合（开门数 / 可投总额）。只含「过去且有数据」的交易日。 */
  totals: Map<string, { opened: number; total: number }>;
}

// 额度量级自适应：满 1 万才用「万」，否则用「元」（真实额度多为几百~几万，
// 强行除以 1 万会变成 0.05万 这种既错又难看的写法）。精确金额仍交给悬停提示。
function fmtAmt(total: number): { n: string; u: string } {
  if (total >= 10000) {
    const wan = total / 10000;
    const n = wan >= 10 ? `${Math.round(wan)}` : wan.toFixed(1);
    return { n, u: '万' };
  }
  return { n: `${Math.round(total)}`, u: '元' };
}
---

<div class="wk-head">
  <div class="wk-head-days">
    <span>一</span><span>二</span><span>三</span><span>四</span><span>五</span>
  </div>
</div>

{weeks.map((w) => (
  <div class:list={['wk-row', { 'is-this-week': w.monday === curMonday }]}>
    <div class="wk-days">
      {w.days.filter((d) => !d.weekend).map((d) => {
        const isFuture = d.date > today;
        const isTrade = d.state === 'TRADING';
        const t = totals.get(d.date);
        // 三种「格子里的内容」互斥：有额度 / 交易日但没数据 / 还没到
        const hasAmt = isTrade && !isFuture && !!t;
        const isGap = isTrade && !isFuture && !t;
        const amt = hasAmt ? fmtAmt(t!.total) : null;
        // 未来格不写原因：它还没到，不是「不能买」
        // 格子里的原因去掉「假期」后缀：这一列一格只有 52px，窄屏 10px 字号下
        // 「国庆节假期」50px 会溢出。名字本身已经足够（悬停卡里仍是完整说法）。
        const reason = isTrade ? null : offReason(d).replace(/假期$/, '');
        const cls = ['wk-d'];
        if (hasAmt) cls.push('is-trade');
        else if (isGap) cls.push('is-gap');
        else if (isFuture) cls.push('is-future');
        else cls.push('is-off');
        if (d.date === today) cls.push('is-today');
        const gapWord = d.date === today ? '待更新' : '未收录';
        const aria = hasAmt
          ? `${d.title}；可投 ¥${t.total.toLocaleString('zh-CN')} · ${t.opened} 家开门`
          : isGap
            ? `${d.title}；当日额度${gapWord}`
            : d.title;
        return (
          <span class={cls.join(' ')} tabindex="0" aria-label={aria}>
            <span class="wk-dt">{d.date.slice(5, 7)}.{d.date.slice(8, 10)}</span>
            {hasAmt && <span class="wk-amt">{amt!.n}<u>{amt!.u}</u></span>}
            {isGap && <span class="wk-gap">{gapWord}</span>}
            {reason && <span class="wk-reason">{reason}</span>}
            <span class="cal-tip" aria-hidden="true">
              <b class="ct-d">{d.md} {d.weekZh}</b>
              <span class="ct-r">
                <i class="ct-k">A 股</i>
                <b class:list={['ct-v', { 'ct-off': !d.cnOpen }]}>{openWord(d.cnOpen)}</b>
                <span class="ct-why">· {d.cnReason}</span>
              </span>
              <span class="ct-r">
                <i class="ct-k">美股</i>
                <b class:list={['ct-v', { 'ct-off': !d.usOpen }]}>{openWord(d.usOpen)}</b>
                <span class="ct-why">· {d.usReason}</span>
              </span>
              {t && (
                <span class="ct-r">
                  <i class="ct-k">额度</i>
                  <b class="ct-v">¥{t.total.toLocaleString('zh-CN')}</b>
                  <span class="ct-why">· {t.opened} 家开门</span>
                </span>
              )}
            </span>
          </span>
        );
      })}
    </div>
  </div>
))}

<p class="wk-out">
  {!outlook.todayTradable ? (
    <>
      今天休市（{outlook.todayReason}），{outlook.nextTradable ? (
        <>下一个交易日是 <b>{outlook.nextTradable.md} {outlook.nextTradable.weekZh}</b>。</>
      ) : (
        <>日历覆盖范围内没有可申购的交易日。</>
      )}
    </>
  ) : outlook.tradingDays === 0 ? (
    <>
      明天起就买不了：<b>{outlook.nextOff!.md} {outlook.nextOff!.weekZh}</b>，{outlook.nextOff!.reason}。
    </>
  ) : (
    <>
      接下来 <b>{outlook.tradingDays}</b> 个交易日都能买（到 <b>{outlook.lastTradable!.md}</b>）{outlook.nextOff ? (
        <>；最近一次买不了是 <b>{outlook.nextOff.md} {outlook.nextOff.weekZh}</b>，{outlook.nextOff.reason}，{outlook.nextOff.daysAway} 天后。</>
      ) : (
        <>；日历覆盖范围内没有休市日。</>
      )}
    </>
  )}
</p>
