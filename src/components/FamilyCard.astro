---
import type { FundShare, PurchaseStatus, DayPoint } from '../data/types';
import { STATUS_LABEL } from '../lib/status';
import LimitHeat from './LimitHeat.astro';

interface Props {
  shares: FundShare[];
  dataCodes?: string;
  hidden?: boolean;
}
const { shares, dataCodes, hidden } = Astro.props;

const first = shares[0];
const name = `${first.company}${first.baseName}${first.currency === 'USD' ? '美元' : ''}`;
// 头部不再放代码串：份额行本来就是「code · A 类」，代码在下方一行一个，头部再列一遍是纯重复

// 家族状态摘要：同家族内各份额状态可能不一致（如 A/C 暂停、D 类限大额待核验）。
// 不再「任一可买即算可投」，而是如实区分：
//   - 既有可买、又有不可买 → 部分可投（PARTIAL）
//   - 全部可买 → 开放 / 限额
//   - 全部不可买 → 暂停 / 封闭 / 未公布（取最具体的一类）
const shareStatuses = shares.map((s) => s.purchaseStatus);
const buyable = shareStatuses.filter((s) => s === 'LIMITED' || s === 'OPEN').length;
const stopped = shareStatuses.filter((s) => s === 'STOPPED').length;
const closed = shareStatuses.filter((s) => s === 'CLOSED').length;
const unknown = shareStatuses.filter((s) => s === 'UNKNOWN').length;
const nonBuyable = stopped + closed + unknown;

type FamilyStatus = 'OPEN' | 'LIMITED' | 'STOPPED' | 'CLOSED' | 'UNKNOWN' | 'PARTIAL';
let famStatus: FamilyStatus;
if (buyable > 0 && nonBuyable > 0) famStatus = 'PARTIAL';
else if (buyable > 0) famStatus = shareStatuses.includes('OPEN') ? 'OPEN' : 'LIMITED';
else if (closed > 0) famStatus = 'CLOSED';
else if (unknown > 0) famStatus = 'UNKNOWN';
else famStatus = 'STOPPED';

const famLabel: Record<FamilyStatus, string> = {
  OPEN: '开放申购',
  LIMITED: '限额申购',
  STOPPED: '暂停申购',
  CLOSED: '封闭期',
  UNKNOWN: '额度未公布',
  PARTIAL: '部分可投',
};

const famCls =
  famStatus === 'STOPPED' ? 'tag-stop'
  : famStatus === 'CLOSED' ? 'tag-closed'
  : famStatus === 'UNKNOWN' ? 'tag-unknown'
  // 「限额」与「部分可投」同一个颜色：两者都只是「能买，但不是全放开」，
  // 区别靠标签文字。★ 2026-10-26 之前 LIMITED 挂在 tag-ok（松绿）上，
  // 于是同一张卡里同时出现两种绿：右上角松绿的「限额申购」+ 下方橄榄的四档热力。
  // 用户 2026-10-23 就说过「限额申购的绿色也换成热力条这个」，这里落到位。
  : famStatus === 'LIMITED' ? 'tag-limit'
  : famStatus === 'PARTIAL' ? 'tag-partial'
  : 'tag-ok';

// 家族可投总额（组内可买份额单日上限之和）。
// 区分「已知额度之和」与「是否含待核验份额」：有缺失时不臆造，用 ≈ 提示被低估。
const famKnownTotal = shares
  .filter((s) => (s.purchaseStatus === 'LIMITED' || s.purchaseStatus === 'OPEN') && s.dailyLimit != null)
  .reduce((a, s) => a + (s.dailyLimit as number), 0);
const famHasMissing = shares.some(
  (s) => (s.purchaseStatus === 'LIMITED' || s.purchaseStatus === 'OPEN') && s.limitMissing
);

// 合并家族历史（用于 21 天热力方块）：任一可买即视为当日开门
const dateSet = new Set<string>();
for (const s of shares) for (const d of s.history) dateSet.add(d.date);
const allDates = [...dateSet].sort();
const byDate = new Map<string, DayPoint[]>();
for (const s of shares) for (const d of s.history) {
  if (!byDate.has(d.date)) byDate.set(d.date, []);
  byDate.get(d.date)!.push(d);
}
const familyHistory: DayPoint[] = allDates.map((date) => {
  const entries = byDate.get(date)!;
  const open = entries.filter((e) => e.status === 'LIMITED' || e.status === 'OPEN');
  const closed = entries.find((e) => e.status === 'CLOSED');
  const unknown = entries.find((e) => e.status === 'UNKNOWN');
  const status: PurchaseStatus = open.length ? 'LIMITED' : closed ? 'CLOSED' : unknown ? 'UNKNOWN' : 'STOPPED';
  // 热力方块用「当日家族合计额度」，与卡片右上角的数字同口径
  const sum = open.reduce((a, e) => a + (e.limit ?? 0), 0);
  return { date, status, limit: open.length && sum > 0 ? sum : null };
});
---

<div class="fam" data-codes={dataCodes} data-index={first.indexKey} hidden={hidden}>
  <div class="fam-head">
    <div class="fam-name">
      {name}
    </div>
    {/* 右侧顺序：状态 → 提示 → 数字。状态贴着家族名读起来是「某某基金 · 限额申购」，
        数字落在最右端，与下方份额行的右边缘对齐成一列。 */}
    <div class="fam-right">
      <span class={`tag ${famCls}`}>{famLabel[famStatus]}</span>
      {famHasMissing && <span class="fam-note">含待核验额度</span>}
      {famKnownTotal > 0 ? (
        <div class="fam-big tnum">{famHasMissing ? '≈' : ''}{famKnownTotal}<span class="u">元</span></div>
      ) : famHasMissing ? (
        <div class="fam-big is-unknown">待核验</div>
      ) : null}
    </div>
  </div>

  {/* 份额压成一行流水：类别 代码 额度，段与段之间用空白隔开，不再放「·」。
      整行统一墨色，不按状态染色：哪只买得到由数字说（10元 / 0元），
      状态由头部那一个标签统一交代；额头一块绿、一块红反而是噪音。
      「0 元」不是猜的额度，是「今天单日可买 0 元」这个事实。
      每段整段不可拆（nowrap），一行放不下时按段折行，绝不把「A类」和代码劈开。 */}
  <div class="fam-shares">
    {
      shares.map((s) => (
        <a
          class="sh"
          href={`/f/${s.code}`}
          data-code={s.code}
          data-status={s.purchaseStatus}
          data-limit={s.dailyLimit != null ? String(s.dailyLimit) : ''}
          aria-label={`${s.shareClass} 类 ${s.code}${s.dailyLimit != null ? ` 单日 ${s.dailyLimit} 元` : ''} · ${STATUS_LABEL[s.purchaseStatus]}`}
        >
          <span class="sh-txt">{s.shareClass}类 {s.code} {s.limitMissing ? '待核验' : `${s.dailyLimit ?? 0}元`}</span>
          {/* 自绘提示，与交易日历同一套纸片皮肤；aria-label 已承担无障碍职责，
              这里的 tip 纯视觉，标 aria-hidden 避免屏幕阅读器读两遍。 */}
          <span class="tip" aria-hidden="true">{s.shortName} · {STATUS_LABEL[s.purchaseStatus]}</span>
        </a>
      ))
    }
  </div>

  <LimitHeat history={familyHistory} />
</div>
