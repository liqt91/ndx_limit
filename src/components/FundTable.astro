---
/**
 * 基金额度列表（一份额一行）。
 *
 * 为什么是表而不是卡片：卡片把「一家基金」画成一个块，一屏只放得下 4–6 家；
 * 额度、状态、费率、跟踪误差四项要横向比，卡片的纵向堆叠逼着人来回扫。
 * 摊成表格后同一列永远是同一口径，扫一眼就能看出「今天谁给得多、谁年费低、谁跟得准」。
 *
 * ★ 一份额一行，不是一家一行：同一家族的 A/C/D 类**额度通常相同**（基金公司按家族设限），
 *   但**费率必然不同**（C 类多一笔销售服务费）、**状态也可能不同**（D 类限大额、A 类暂停）。
 *   合并成一家一行就必须在格子里塞「A 0.65% / C 0.90%」这种二阶排版，
 *   拆开则每行只有一个数，代价是行数翻倍。这里选拆开。
 *
 * ★ 状态没有独立列（2026-10-27 定）：额度列已经说明了——有数字就是能买，
 *   横杠就是不可买，待核验就是能买但金额未公布。再加一列「可投/暂停」是同一件事说两遍。
 *
 * ★ 跟踪误差按**家族**只在首行显示一次：它是指数基金跟踪组合的质量，
 *   同一只基金不同份额类别跟踪的是同一个组合（实测 18 个家族里 11 个各类别完全相同，
 *   其余仅差 0.01%）。41 行重复同一个数字纯属噪音。
 *
 * ★ 序号 / 基金名 / 跟踪误差**都是家族级**，都用 rowspan 跨满整组（见模板内注释）。
 *   三格一起跨，组才立得住：只剩跟踪误差跨行、名字还挤在首行，组界仍是"名字上行、
 *   数字居中"两套语言。现在这三格在组的垂直中线上一字排开，右边四列才是份额级。
 *   基金名用 `.fam-name`：多指数门禁靠它从 dist 里提取家族名，校验「分站首页不含
 *   对方指数的家族」。一个字都不许多写——续行若也写名字，扫表时「一家基金」就被
 *   切成几段等高的行。
 *   ★ 名字只出现一次，组界就得靠别的东西读：`> td` 上那条 --rule-2 的线（比组内的
 *     --rule 深一档）。这条线画了两轮才真的上屏——`border-collapse: collapse` 下
 *     行边框会被上一行的 border-bottom 抢走颜色，必须落到单元格上。
 *   ★ 窄屏（≤700px）曾用 `tr[data-name]::before` 给续块补一遍名字（每块是独立单元），
 *     2026-10-27 六轮删掉：用户要「C/D 是下层的信息更明显一点」，续块直接从
 *     `[C] 008971` 开始、比组首块矮一行，靠「组内间距 5px < 组间 16px」读归属。
 *     那个 `data-name` 属性随之没人用，一并删了。读屏不受影响：份额链接的
 *     aria-label 里仍带全名。
 */
import type { FundShare } from '../data/types';
import LimitHeat from './LimitHeat.astro';
import { feeOf, familyTracking, fmtPct } from '../data/extras';

interface Props {
  /** 已按类别排好序的家族分组（调用方负责排序，这里不再排） */
  groups: { currency: string; shares: FundShare[] }[];
  /** 家族序号起点：人民币组从 1 起算 */
  startIndex?: number;
}

const { groups, startIndex = 1 } = Astro.props;
const pad2 = (n: number) => String(n).padStart(2, '0');

/**
 * 额度三态。用列头交代单位，单元格只放数字，等宽数字才能右对齐成一列。
 *   · 有数字 → 今天能买这么多
 *   · 待核验 → 状态是「限额/开放」但上游没给金额（limitMissing），不臆造成 0
 *   · 横杠   → 暂停/封闭/未知，今天买不到
 */
function amount(s: FundShare): { text: string; cls: string } {
  const open = s.purchaseStatus === 'LIMITED' || s.purchaseStatus === 'OPEN';
  if (!open) return { text: '—', cls: 'is-off' };
  if (s.dailyLimit == null) return { text: '待核验', cls: 'is-warn' };
  return { text: s.dailyLimit.toLocaleString('zh-CN'), cls: '' };
}

const rows = groups.flatMap((g, gi) => {
  const head = g.shares[0];
  const name = `${head.company}${head.baseName}${g.currency === 'USD' ? '美元' : ''}`;
  // 列里只显示公司名：整页就是一个指数（页标题、导航、站名都写着），
  // 每行再印一遍「纳斯达克100」是 41 行重复同一句话，而且把列撑到必须折行
  // ——「宝盈纳斯达克 / 100」这种断法还断在数字前面，比不写更难看。
  // 全名仍要留着：`data-fam` 供多指数门禁校验「这页有没有串入对方指数」，
  // aria-label 供读屏；两者都不受排版影响。
  const display = `${head.company}${g.currency === 'USD' ? '美元' : ''}`;
  // 家族级指标取组内第一个有值的份额（组内已按 A→C→D 排序）
  const te = familyTracking(g.shares);
  const codes = g.shares.map((s) => s.code).join(' ');
  return g.shares.map((s, si) => ({
    share: s,
    si,
    name,
    display,
    te,
    codes,
    /** 跟踪误差格要跨的行数（= 该家族的份额数）。单份额家族不用 rowspan。 */
    span: g.shares.length,
    no: pad2(startIndex + gi),
    amt: amount(s),
    fee: feeOf(s.code),
  }));
});
---

<div class="ftblwrap">
  <table class="ftbl">
    {/* 固定列宽（table-layout:fixed）：auto 布局会把余量全给某一列，
        序号与基金名之间被撑出几百像素的空白。热力条吃掉最后一列的余量。 */}
    <colgroup>
      <col class="c-no-w" />
      <col class="c-fund-w" />
      <col class="c-code-w" />
      <col class="c-amt-w" />
      <col class="c-fee-w" />
      <col class="c-te-w" />
      <col />
    </colgroup>
    <thead>
      <tr>
        <th></th>
        <th>基金</th>
        <th>份额</th>
        <th class="num">额度<span class="u">元</span></th>
        <th class="num">年费</th>
        <th class="num">跟踪误差</th>
        <th class="th-heat">21 日热力</th>
      </tr>
    </thead>
    <tbody>
      {
        rows.map((r) => (
          <tr
            class={r.si === 0 ? 'fr fr-head' : 'fr'}
            data-index={r.share.indexKey}
            data-code={r.share.code}
            data-status={r.share.purchaseStatus}
            data-limit={r.share.dailyLimit != null ? String(r.share.dailyLimit) : ''}
          >
            {/* ★ 2026-10-27 三轮：序号与基金名跟着跟踪误差一起 rowspan 跨满整组。
                原来三格里的名字只落在首行，读起来是「A 类那行有名字，下面两行是它的附注」；
                跨行后三格在组的垂直中线上并排，组才是一个块、份额才是块里的行。
                ★ 只在首行渲染，续行**不输出空 td**——rowspan 已占列，多一个空格会把
                  后面的份额/额度/年费整体推开一格（跟踪误差那边踩过）。 */}
            {r.si === 0 ? (
              <td class="c-no" rowspan={r.span > 1 ? r.span : undefined}>{r.no}</td>
            ) : null}
            {r.si === 0 ? (
              <td class="c-fund" rowspan={r.span > 1 ? r.span : undefined}>
                <div class="fam-name" data-fam={r.name}>{r.display}</div>
              </td>
            ) : null}
            <td class="c-code">
              <a
                class="shc"
                href={`/f/${r.share.code}`}
                aria-label={`${r.name} ${r.share.shareClass} 类 ${r.share.code}`}
              >
                <b class="cls">{r.share.shareClass}</b>
                {r.share.code}
              </a>
            </td>
            <td class={`c-amt ${r.amt.cls}`}>{r.amt.text}</td>
            <td class="c-fee" title={`管理 ${fmtPct(r.fee.mgmt)} + 托管 ${fmtPct(r.fee.custody)} + 销售服务 ${fmtPct(r.fee.sales)}`}>
              {fmtPct(r.fee.annualTotal)}
            </td>
            {/* 跟踪误差：**rowspan 跨满整个家族**，不再只落在 A 类那一行上。
                ★ 2026-10-27 用户：「感觉跟踪误差是在说份额 A 的基金」——数字挤在首行
                  右端，位置就在说「这是 A 类的」。它其实是基金（家族）级指标：
                  同一只基金的各份额类别跟踪的是同一个组合（实测 11/18 完全相同，
                  其余只差 0.01%）。表格里表达「一个值适用于这几行」的原生写法就是
                  rowspan：格子在视觉上竖跨整组、垂直居中，归属立刻变成「这一家」。
                ★ 副作用是**整行 hover 高亮会在这一列留一个缺口**——跨行格属于首行，
                  悬停续行时它不跟着变灰。这个缺口恰好说的是真话：它不属于任何单个
                  份额，属于整组。所以宁可留着缺口，也不把 hover 改成描边。
                ★ 单份额家族不写 rowspan（rowspan="1" 在部分浏览器里会引出多余的分隔线）。 */}
            {/* ★ 只在家族首行渲染这个格子（带 rowspan）：续行**不能再输出空的 td**，
                否则 rowspan 已经占了那一列，多出来的空格会把续行的后两列全部推开。 */}
            {r.si === 0 ? (
              <td class="c-te" rowspan={r.span > 1 ? r.span : undefined}>
                {fmtPct(r.te?.trackingError ?? null)}
              </td>
            ) : null}
            <td class="c-heat">
              <LimitHeat history={r.share.history} axis={false} pad variant="bars" />
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
