---
import BaseLayout from '../layouts/BaseLayout.astro';
import DigestWall from '../components/DigestWall.astro';
import { loadDailySummaries, loadDailyChangeHistory, loadDailyIntraday, loadDataTimeNote, loadDailyBuyable, NDX, SP500 } from '../data/loader';

// 订阅页日报墙：最近 30 个交易日的日报归档，每天一条 = 一封邮件的样子
// （纳指段 + 标普段同屏，与真实群发邮件同源）。让访客订阅前先预览「会收到什么」。
const N_DAYS = 30;
const ndxSum = loadDailySummaries(N_DAYS, NDX);
const ndxChg = loadDailyChangeHistory(N_DAYS, NDX);
const spSum = loadDailySummaries(N_DAYS, SP500);
const spChg = loadDailyChangeHistory(N_DAYS, SP500);
const spSumMap = new Map(spSum.map((s) => [s.date, s]));
const spChgMap = new Map(spChg.map((c) => [c.date, c]));

// 邮件第 1 段的「抓取时刻」与第 3 段「较盘前/日内变化」只存在于 fetch-meta.json 的
// 最新一天（历史日未留存逐日 intraday 与时刻），所以只有最新那张卡片能完整镜像邮件。
const timeNote = loadDataTimeNote();
const ndxIntra = loadDailyIntraday(NDX);
const spIntra = loadDailyIntraday(SP500);
const latestDate = timeNote.date; // 与 intraday 同源（都来自 fetch-meta 当天）

// 「今日能买」清单：与邮件正文同一个实现（loader → digest.mjs 的 buyableFamilies），
// 每天一份、按家族分组。缺这一块的话，墙上就只剩「几家开门」，订阅前看不到
// 「信里会给代码和额度」这件事。
const ndxBuy = loadDailyBuyable(N_DAYS, NDX);
const spBuy = loadDailyBuyable(N_DAYS, SP500);

const days = ndxSum.map((s) => ({
  date: s.date,
  label: s.label,
  segs: [
    {
      label: '纳指100',
      summary: s,
      changes: ndxChg.find((c) => c.date === s.date) ?? null,
      dataNote: s.date === latestDate ? timeNote.note : '',
      intraday: s.date === latestDate ? ndxIntra : null,
      buyable: ndxBuy.get(s.date) ?? [],
    },
    {
      label: '标普500',
      summary: spSumMap.get(s.date) ?? null,
      changes: spChgMap.get(s.date) ?? null,
      dataNote: s.date === latestDate ? timeNote.note : '',
      intraday: s.date === latestDate ? spIntra : null,
      buyable: spBuy.get(s.date) ?? [],
    },
  ],
}));


// 订阅走自己的边缘函数（EdgeOne Edge Functions），不再依赖第三方表单：
//   浏览器 POST /api/subscribe（同源，不跳转）→ 边缘函数写 KV → 返回 JSON
// 每天 14:45 由调度拉 /api/subscribers 取名单，再用 SMTP 群发（收盘前报）。
// 访客全程只访问本站域名，国内不需要任何代理。
//
// 订阅范围（indices）是可选的：勾哪些指数就只收哪些，发信侧按 KV 里的 indices 裁剪正文。
// 已确认的邮箱再提交一次只会合并范围（不重发确认信），这是「加订一个指数」的唯一入口。
---

<BaseLayout title="订阅日报 - QDII 开门日报" siteName="QDII 开门日报" headerBrand="开门日报" shortName="QDII 日报" navKey={null}>
  <h1 class="section-title">订阅日报</h1>
  <p class="my-hint">
    每天收盘前（场外申购 15:00 截止前），把当天 QDII 基金的开门与限购变化发到你的邮箱。
    只填邮箱，提交后去收件箱点一下确认链接就完成了。
  </p>

  <form class="form" id="sub-form" novalidate>
    <label for="email">邮箱地址</label>
    <input
      type="email"
      id="email"
      name="email"
      placeholder="you@example.com"
      autocomplete="email"
      inputmode="email"
      required
    />

    <!-- 订阅范围：默认两个都勾。一个不勾会被拦下——不勾等于「订了个不收的信」，
         与其静默按默认值发，不如让他明确选。 -->
    <fieldset class="pick" id="pick">
      <legend>订阅范围</legend>
      <label class="pick-item" for="pick-ndx">
        <input type="checkbox" id="pick-ndx" name="indices" value="纳斯达克100" checked />
        <span>纳指100</span>
      </label>
      <label class="pick-item" for="pick-sp500">
        <input type="checkbox" id="pick-sp500" name="indices" value="标普500" checked />
        <span>标普500</span>
      </label>
    </fieldset>

    <!-- 蜜罐：视觉隐藏且不可聚焦，正常人填不到；被填即判断为机器人 -->
    <div class="hp" aria-hidden="true">
      <label for="trap">请勿填写此栏</label>
      <input type="text" id="trap" name="trap" tabindex="-1" autocomplete="off" />
    </div>

    <button type="submit" id="sub-btn">订阅</button>

    <p class="form-status" id="sub-status" role="status" aria-live="polite"></p>
  </form>

  <!-- 说明段放在 form 之外：.form 有 max-width:460px，写在 form 里会被表单宽度
       卡住而不得不在句中折行。表单只装输入控件，说明文字不受它的宽度约束。 -->
  <div class="form-notes">
    <p class="note">
      提交后会收到一封确认信，点信里的链接才正式入名单（1 天内有效，未确认不会收到日报）
    </p>
    <p class="note">
      只订一个指数就只收那一个。想改范围：回到这页再填一次邮箱即可，已经确认过的地址不会再要求确认
    </p>
    <p class="note">
      如果没看到来信，先翻一下垃圾箱，并把发件人加进白名单  ：）
    </p>
  </div>

  <noscript>
    <p class="note">订阅需要开启 JavaScript。也可以在浏览器的开发者工具里关闭脚本限制后重试。</p>
  </noscript>

  <!-- 日报墙：放在表单与说明之后，让访客订阅前先看到「订阅后会收到这样的日报」。
       每天一条 = 一封邮件的样子（纳指段 + 标普段同屏），与真实群发邮件同源。 -->
  <section class="digest-section" aria-label="最近日报">
    <h2 class="digest-title">最近日报</h2>
    <p class="digest-hint">这就是订阅后会收到的邮件：每天收盘前一条，含当日可投总额与开门家数，以及相对上一交易日的变化。</p>
    <DigestWall days={days} />
  </section>

  <script>
    const form = document.getElementById('sub-form');
    if (form) {
      const btn = document.getElementById('sub-btn');
      const status = document.getElementById('sub-status');
      const emailInput = document.getElementById('email');
      const trap = document.getElementById('trap');
      const boxes = Array.from(form.querySelectorAll('input[name="indices"]'));
      const idleLabel = btn.textContent;

      const setStatus = (msg, kind) => {
        status.textContent = msg;
        status.className = 'form-status' + (kind ? ' is-' + kind : '');
      };
      const picked = () => boxes.filter((b) => b.checked).map((b) => b.value);

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const email = (emailInput.value || '').trim();
        if (!email) {
          setStatus('请先填邮箱。', 'err');
          emailInput.focus();
          return;
        }
        const indices = picked();
        if (!indices.length) {
          setStatus('至少选一个指数。', 'err');
          return;
        }

        btn.disabled = true;
        btn.textContent = '提交中…';
        setStatus('');

        try {
          const res = await fetch('/api/subscribe', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ email, indices, trap: trap ? trap.value : '' }),
          });
          const data = await res.json().catch(() => ({}));

          if (res.ok && data.ok) {
            emailInput.disabled = true;
            boxes.forEach((b) => (b.disabled = true));
            if (data.pending) {
              // 双重确认：还没入名单，得去邮箱点一下链接
              btn.textContent = '待确认';
              setStatus('确认邮件已发到 ' + email + '，点信里的链接才完成订阅（1 天内有效）。', 'ok');
            } else if (data.duplicated) {
              btn.textContent = '已订阅 ✓';
              setStatus(
                data.updated
                  ? '订阅范围已更新为 ' + (data.indices || indices).join(' + ') + '，不用再确认。'
                  : '这个邮箱已经在名单里了（' + (data.indices || indices).join(' + ') + '），不用重复订阅。',
                'ok'
              );
            } else {
              btn.textContent = '已订阅 ✓';
              setStatus('已订阅。每天收盘前的日报会发到 ' + email + '。', 'ok');
            }
            return;
          }

          btn.disabled = false;
          btn.textContent = idleLabel;
          setStatus(
            data.error === 'bad_email' ? '这个邮箱格式看起来不对，检查一下？' : '订阅服务暂时不可用，请稍后再试。',
            'err'
          );
        } catch {
          btn.disabled = false;
          btn.textContent = idleLabel;
          setStatus('网络异常，请稍后再试。', 'err');
        }
      });
    }
  </script>
</BaseLayout>
