---
import BaseLayout from '../layouts/BaseLayout.astro';

// 订阅走自己的边缘函数（EdgeOne Edge Functions），不再依赖第三方表单：
//   浏览器 POST /api/subscribe（同源，不跳转）→ 边缘函数写 KV → 返回 JSON
// 每天 14:45 由 EdgeOne schedules 拉 /api/subscribers 取名单，再用 SMTP 群发。
// 访客全程只访问本站域名，国内不需要任何代理。
---

<BaseLayout title="订阅日报 - 纳指开门日报">
  <h1 class="section-title">订阅日报</h1>
  <p class="my-hint">
    每天下午收盘前，把当天纳指基金的开门与限购变化发到你的邮箱。只填邮箱，提交后去收件箱点一下确认链接就完成了。
  </p>

  <form class="form" id="sub-form" novalidate>
    <label for="email">邮箱地址</label>
    <input
      type="email"
      id="email"
      name="email"
      placeholder="you@example.com"
      autocomplete="email"
      inputmode="email"
      required
    />

    <!-- 蜜罐：视觉隐藏且不可聚焦，正常人填不到；被填即判断为机器人 -->
    <div class="hp" aria-hidden="true">
      <label for="trap">请勿填写此栏</label>
      <input type="text" id="trap" name="trap" tabindex="-1" autocomplete="off" />
    </div>

    <button type="submit" id="sub-btn">订阅</button>

    <p class="form-status" id="sub-status" role="status" aria-live="polite"></p>
  </form>

  <!-- 说明段放在 form 之外：.form 有 max-width:460px，写在 form 里会被表单宽度
       卡住而不得不在句中折行。表单只装输入控件，说明文字不受它的宽度约束。 -->
  <div class="form-notes">
    <p class="note">
      提交后会收到一封确认信，点信里的链接才正式入名单（1 天内有效，未确认不会收到日报）
    </p>
    <p class="note">
      如果没看到来信，先翻一下垃圾箱，并把发件人加进白名单  ：）
    </p>
  </div>

  <noscript>
    <p class="note">订阅需要开启 JavaScript。也可以在浏览器的开发者工具里关闭脚本限制后重试。</p>
  </noscript>

  <script>
    const form = document.getElementById('sub-form');
    if (form) {
      const btn = document.getElementById('sub-btn');
      const status = document.getElementById('sub-status');
      const emailInput = document.getElementById('email');
      const trap = document.getElementById('trap');
      const idleLabel = btn.textContent;

      const setStatus = (msg, kind) => {
        status.textContent = msg;
        status.className = 'form-status' + (kind ? ' is-' + kind : '');
      };

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const email = (emailInput.value || '').trim();
        if (!email) {
          setStatus('请先填邮箱。', 'err');
          emailInput.focus();
          return;
        }

        btn.disabled = true;
        btn.textContent = '提交中…';
        setStatus('');

        try {
          const res = await fetch('/api/subscribe', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ email, trap: trap ? trap.value : '' }),
          });
          const data = await res.json().catch(() => ({}));

          if (res.ok && data.ok) {
            emailInput.disabled = true;
            if (data.pending) {
              // 双重确认：还没入名单，得去邮箱点一下链接
              btn.textContent = '待确认';
              setStatus('确认邮件已发到 ' + email + '，点信里的链接才完成订阅（1 天内有效）。', 'ok');
            } else {
              btn.textContent = '已订阅 ✓';
              setStatus('已订阅。每天下午的日报会发到 ' + email + '。', 'ok');
            }
            return;
          }

          btn.disabled = false;
          btn.textContent = idleLabel;
          setStatus(
            data.error === 'bad_email' ? '这个邮箱格式看起来不对，检查一下？' : '订阅服务暂时不可用，请稍后再试。',
            'err'
          );
        } catch {
          btn.disabled = false;
          btn.textContent = idleLabel;
          setStatus('网络异常，请稍后再试。', 'err');
        }
      });
    }
  </script>
</BaseLayout>
