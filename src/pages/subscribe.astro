---
import BaseLayout from '../layouts/BaseLayout.astro';

// 纯静态站没有后端，订阅人收集交给 Buttondown（邮件简报服务）：
// 表单 POST 到 Buttondown 公开 embed 端点（免密钥），订阅人确认后进入名单；
// 每日 08:00 的 GitHub Actions 再调 Buttondown API 把日报群发给名单里所有人。
// 部署前把 USERNAME 换成你自己的 Buttondown 用户名（按钮：Settings → Embedding 里的用户名）。
const FORM_ACTION = 'https://buttondown.com/api/emails/embed-subscribe/YOUR_BUTTONDOWN_USERNAME';
---

<BaseLayout title="订阅日报 - 纳指开门日报">
  <div class="ctx">
    <span>每天早上 8 点推送</span>
    <a href="/">今日 →</a>
  </div>
  <h1 class="section-title">订阅日报</h1>
  <p class="my-hint">每天早上 8 点，把当天纳指基金的开门与限购变化发到你的邮箱。</p>
  <form class="form" action={FORM_ACTION} method="POST" target="_blank">
    <label for="email">邮箱地址</label>
    <input type="email" id="email" name="email" placeholder="you@example.com" required />
    <input type="hidden" name="embed" value="1" />
    <button type="submit">订阅</button>
    <p class="note">
      提交后会跳转到确认页，确认订阅即可。本页为纯静态，订阅与每日群发均由 Buttondown 托管，
      站点本身不存任何邮箱（详见项目 README）。
    </p>
  </form>
</BaseLayout>
