---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHead from '../../components/SectionHead.astro';
import { loadAllShares, loadUsdShares, loadAnnouncementsFor, indexMeta } from '../../data/loader';
import { STATUS_LABEL, statusClass } from '../../lib/status';
import type { FundShare, PurchaseStatus } from '../../data/types';

export function getStaticPaths() {
  // 不传 indexKey = 跨指数全量：标普500 的份额也要有自己的详情页
  const shares = [...loadAllShares(), ...loadUsdShares()];
  return shares.map((s) => ({ params: { code: s.code }, props: { share: s } }));
}

const { share } = Astro.props as { share: FundShare };

// 详情页属于哪个指数，就回哪个指数的首页——从标普500 卡片点进来看完，「返回今日」
// 把人送回纳指首页是错的（两页长得一样，读者会以为额度变了）
const meta = indexMeta(share.indexKey);
const homeHref = meta.path;
// 按 indexKey 判断，不按 path 判断：2026-10-23 起两个指数都在 /<index> 下，
// 「path === '/'」这种写法再也命中不了，会把两个指数的回跳文案都写成「← 返回标普500」。
const homeLabel = `← 返回${meta.label}`;

// 历史按从新到旧展示
const history = [...share.history].reverse();
// 页头「数据日期」要的是最新一天。history 已经反转过，取末项会拿到最旧的一天
// （回填 21 天历史后这个错会被放大成「数据日期 2026-09-14」），所以从原数组取。
const newest = share.history[share.history.length - 1];

const currencyLabel = share.currency === 'USD' ? '美元' : '人民币';
// 申购类公告：额度为什么变，答案大多在这一节里（上游公告接口只有日期，没有时分）
const anns = loadAnnouncementsFor(share.code);
const heroLabel = share.dailyLimit != null ? '单日最多可投（代销）' : '当前申购状态';
const heroCls =
  share.dailyLimit != null ? 'is-open'
  : share.purchaseStatus === 'STOPPED' ? 'is-stop'
  : share.purchaseStatus === 'CLOSED' ? 'is-closed'
  : '';
---

<BaseLayout title={`${share.shortName} - ${meta.brand}`} siteName={meta.brand} shortName={`${meta.short}日报`} navKey={share.indexKey} indexKey={share.indexKey}>
  <div class="ctx">
    <a href={homeHref}>{homeLabel}</a>
    <span>数据日期 {newest?.date}</span>
  </div>

  <h1 class="section-title">{share.shortName}</h1>
  <div class="detail-meta">
    {share.code} · {share.company} · {share.indexKey} · {share.shareClass} 类 · {currencyLabel}
  </div>

  <section class="hero">
    <div class="hero-label">{heroLabel}</div>
    <div class={`hero-value ${heroCls}`}>
      {
        share.dailyLimit != null ? (
          <>
            {share.dailyLimit}
            <i class="hv-u">元</i>
          </>
        ) : (
          STATUS_LABEL[share.purchaseStatus]
        )
      }
    </div>
    {
      share.limitMissing && (
        <div class="hero-note">单日额度待核验：页面显示「限大额」但未公布具体上限，请以下单页面为准。</div>
      )
    }
  </section>

  <nav class="ext-links" aria-label="在其它平台查看本基金的页面">
    <a href={`https://fund.eastmoney.com/${share.code}.html`} target="_blank" rel="noopener noreferrer">天天基金</a>
    <a href={`https://finance.sina.com.cn/fund/quotes/${share.code}/bc.shtml`} target="_blank" rel="noopener noreferrer">新浪财经</a>
    <a href={`https://www.morningstar.cn/fund/${share.code}.html`} target="_blank" rel="noopener noreferrer">晨星网</a>
  </nav>

  <SectionHead index="01" title="历史记录 · 近 30 天" />
  <table class="tbl">
    <thead>
      <tr>
        <th>日期</th>
        <th>状态</th>
        <th class="num">单日额度</th>
      </tr>
    </thead>
    <tbody>
      {
        history.map((d) => (
          <tr>
            <td>{d.date}</td>
            <td class={statusClass(d.status as PurchaseStatus)}>{STATUS_LABEL[d.status as PurchaseStatus]}</td>
            <td class="num">
              {d.limit != null ? `${d.limit} 元` : d.status === 'LIMITED' ? <span class="lim-unknown">待核验</span> : '—'}
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>

  {
    anns.length > 0 && (
      <>
        <SectionHead index="02" title="申购相关公告" />
        <ul class="ann-list">
          {anns.map((a) => (
            <li class="ann-row">
              <span class="ann-date">{a.date.slice(5)}</span>
              <a class="ann-action" href={a.url} target="_blank" rel="noopener noreferrer">
                {a.action}
              </a>
              <span class="ann-t" title={a.title}>{a.title}</span>
            </li>
          ))}
        </ul>
        <p class="ann-note">公告来自天天基金，只保留与申购额度相关的那几类（直销渠道公告、境外节假日临时暂停、费率优惠已剔除）。公告只标注日期，不标时点。</p>
      </>
    )
  }
</BaseLayout>
