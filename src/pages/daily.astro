---
// 旧路径兼容：/daily 曾是「交易日历 + 纳指每日快照」。拆分成两条路由后，
// 这里留一个跳转垫片，让日报邮件、书签、聊天记录里的旧链接不至于直接 404。
import JumpPage from '../components/JumpPage.astro';
import { NDX, indexMeta } from '../data/loader';

const meta = indexMeta(NDX);
---

<JumpPage
  to="/ndx100/daily"
  title={`历史 - ${meta.brand}`}
  description={`${meta.label}的每日快照与交易日历。`}
  linkText="历史页"
/>
