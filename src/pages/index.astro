---
import BaseLayout from '../layouts/BaseLayout.astro';
import FamilyCard from '../components/FamilyCard.astro';
import SectionHead from '../components/SectionHead.astro';
import { loadTodaySnapshot, loadDailyChanges, getTradingContext, tradingWindowMap } from '../data/loader';
import { STATUS_SHORT } from '../lib/status';
import type { FundShare } from '../data/types';

const snap = loadTodaySnapshot();
const changes = loadDailyChanges();
const ctx = getTradingContext(snap.snapDate);

const byGroup = new Map<string, { currency: string; shares: FundShare[] }>();
for (const s of snap.shares) {
  const key = `${s.company}|${s.baseName}|${s.currency}`;
  if (!byGroup.has(key)) byGroup.set(key, { currency: s.currency, shares: [] });
  byGroup.get(key)!.shares.push(s);
}
const groups = [...byGroup.values()];
const cny = groups.filter((g) => g.currency === 'CNY');
// 美元份额不在站内展示（仅监控人民币份额，过滤在 loader 统一做）

const isOpen = (g: { shares: FundShare[] }) =>
  g.shares.some((s) => s.purchaseStatus === 'LIMITED' || s.purchaseStatus === 'OPEN');
const openedCny = cny.filter(isOpen).length;
const stoppedCny = cny.length - openedCny;

const totalAgency = snap.shares
  .filter(
    (s) =>
      s.currency === 'CNY' &&
      (s.purchaseStatus === 'LIMITED' || s.purchaseStatus === 'OPEN') &&
      s.dailyLimit != null
  )
  .reduce((a, s) => a + (s.dailyLimit as number), 0);

// 柱图标尺：按「家族当日合计额度」的最大值取整到 10 的倍数（最低 30），
// 这样柱子能真正拉开差距，而不是所有额度都被固定分母压成一样高的小方块。
const famTotals = cny.map((g) =>
  g.shares
    .filter(
      (s) =>
        (s.purchaseStatus === 'LIMITED' || s.purchaseStatus === 'OPEN') && s.dailyLimit != null
    )
    .reduce((a, s) => a + (s.dailyLimit as number), 0)
);
const limitCap = Math.max(30, Math.ceil(Math.max(0, ...famTotals) / 10) * 10);

// 开篇陈述：全开门 / 部分 / 全暂停
const level = stoppedCny === 0 ? 'open' : stoppedCny < cny.length ? 'warn' : 'stop';

// 今日判定：有变化就把变化写进首屏，没变化也要在首屏说清楚「没变化」
const changeParts = [
  changes.opened ? `${changes.opened} 只开门` : '',
  changes.stopped ? `${changes.stopped} 只暂停` : '',
  changes.limitChanged ? `${changes.limitChanged} 只调额度` : '',
].filter(Boolean);
const hasChanges = changes.hasData && changeParts.length > 0;
const verdictText = hasChanges ? changeParts.join('，') : '没有变化';

// 额度类变动直接显示「5 元 → 10 元」，比「限大额 → 限大额」有用
const isLimitKind = (k: string) => k.startsWith('limit');
const fmtLimit = (v: number | null) => (v == null ? '未公布' : `${v} 元`);

// 首屏的日期指代：数据是今天的才说「今天」，否则说「上个交易日」或具体日期。
// 不用「昨天」——昨天可能是周六，上一个有数据的交易日未必是昨天。
const dayRef = ctx.dataLabel === '今日' ? '今天' : ctx.dataLabel;
// 交易日窗口表（过去 10 天 + 未来 30 天）：客户端据此判断「今天该不该有新数据」、
// 「数据日是不是上个交易日」——靠日期间隔猜会在长假上出错
const tradingMap = tradingWindowMap(10, 30);
---

<BaseLayout title="纳指开门日报">
  <section class="masthead">
    <div class="mast-kicker">
      <span class={`dot dot-${level}`}></span>
      <span class="mast-updated">
        数据更新于<span data-updated-label>{ctx.dataLabel}</span>{ctx.updatedTime ? <span class="mast-updated-t">{ctx.updatedTime}</span> : null}
      </span>
      <span>·</span>
      <span>纳指 QDII 申购额度</span>
    </div>
    <h1 class="mast-lead">
      {
        ctx.isTrading ? (
          stoppedCny === 0 ? (
            <><span data-day-ref>{dayRef}</span> <span class="num">{openedCny}</span> 家全部开门。</>
          ) : stoppedCny === cny.length ? (
            <><span data-day-ref>{dayRef}</span> <span class="num">{cny.length}</span> 家全部暂停申购。</>
          ) : (
            <><span data-day-ref>{dayRef}</span> <span class="num">{openedCny}</span> 家开门，<span class="num">{stoppedCny}</span> 家暂停。</>
          )
        ) : (
          <>今日休市（非交易日）</>
        )
      }
    </h1>

    <div class="mast-summary">
      {
        ctx.isTrading ? (
          <>
            {changes.prevDate && (
              <span class="mast-sum-item">较上个交易日（{changes.prevDate}）{verdictText}</span>
            )}
            <span class="mast-sum-item">总可投人民币 <span class="tnum">{totalAgency.toLocaleString('zh-CN')}</span> 元</span>
          </>
        ) : (
          <>
            <span class="mast-sum-item">总可投人民币 <span class="tnum">0</span> 元</span>
            {ctx.lastTrading?.date && (
              <span class="mast-sum-item">最近交易日（{ctx.lastTrading.date}）{ctx.lastTrading.opened} 家开门 · 可投 {ctx.lastTrading.total} 元</span>
            )}
          </>
        )
      }
    </div>

    {/* 数据过期提示：静态页不会自己变，由下面的内联脚本按浏览器当天日期点亮。
        服务端默认 hidden —— 没 JS 时宁可不说，也不要按构建日的判断说错。 */}
    <div class="stale-hint" id="stale-hint" hidden><span data-stale-text></span></div>
  </section>

  {
    hasChanges && ctx.isTrading && (
      <>
        <SectionHead index="01" title="今日变化" aside={`共 ${changes.changes.length} 处`} />
        <div class="changelog">
          <ul class="changelog-list">
            {changes.changes.map((c) => (
              <li class={`cl-row cl-${c.kind}`}>
                <span class="cl-name">
                  <i class={`cl-dot cl-dot-${c.kind}`}></i>
                  {c.shortName}
                </span>
                <span class="cl-transition">
                  {isLimitKind(c.kind) ? (
                    <>
                      <span class="cl-from">{fmtLimit(c.fromLimit)}</span>
                      <span class="cl-arrow">→</span>
                      <span class="cl-to">{fmtLimit(c.toLimit)}</span>
                    </>
                  ) : (
                    <>
                      <span class="cl-from">{STATUS_SHORT[c.fromStatus]}</span>
                      <span class="cl-arrow">→</span>
                      <span class="cl-to">
                        {STATUS_SHORT[c.toStatus]}
                        {c.toLimit != null ? ` ${c.toLimit} 元` : ''}
                      </span>
                    </>
                  )}
                </span>
              </li>
            ))}
          </ul>
        </div>
      </>
    )
  }

  <SectionHead
    index={ctx.isTrading && hasChanges ? '02' : '01'}
    title={ctx.isTrading ? `${dayRef}能买多少` : `最近交易日额度（${ctx.lastTrading?.date ?? ''}）`}
    aside={`${openedCny} 家可买 · 柱高 ${limitCap} 元满格`}
  />
  <div class="grid-legend legend-under">
    <span><i class="lg lg-open"></i>可投 / 限大额</span>
    <span><i class="lg lg-stop"></i>暂停</span>
    <span><i class="lg lg-changed"></i>当日变动</span>
  </div>

  <ul class="grid">
    {cny.map((g) => <FamilyCard shares={g.shares} limitCap={limitCap} />)}
  </ul>

  {/* 放在页面最末尾：脚本要改 H1 和下方小节标题，必须在这些节点解析完之后执行 */}
  <script is:inline define:vars={{ dataDate: ctx.dataDate, tradingMap }}>
    // 静态页隔夜不会自己变：按浏览器当天（东八区）判断数据是否过期，统一改日期指代并亮提示。
    // 周末/节假日不提示——那天本来就没有新数据，提示会变成每天误报。
    (function () {
      var today;
      try {
        today = new Intl.DateTimeFormat('en-CA', {
          timeZone: 'Asia/Shanghai', year: 'numeric', month: '2-digit', day: '2-digit',
        }).format(new Date());
      } catch (e) { return; }
      if (!/^\d{4}-\d{2}-\d{2}$/.test(today) || today <= dataDate) return;

      var p = dataDate.split('-');
      var zh = Number(p[1]) + '月' + Number(p[2]) + '日';
      var shift = function (d, n) {
        var q = d.split('-');
        return new Date(Date.UTC(+q[0], +q[1] - 1, +q[2] + n)).toISOString().slice(0, 10);
      };
      // 数据日是不是「上个交易日」：从今天往前找最近一个交易日精确比对，
      // 不靠「间隔几天」猜——长假里猜出来的「上个交易日」可能是错的。
      var prev = null;
      for (var i = 1; i <= 10; i++) {
        var x = shift(today, -i);
        if (tradingMap[x] === 1) { prev = x; break; }
        if (tradingMap[x] === undefined) break;
      }
      var words = prev === dataDate ? '上个交易日' : zh;

      // kicker / H1 / 小节标题三处一起改，否则会出现「今日未更新」与「今天 8 家开门」并存
      var labelEl = document.querySelector('[data-updated-label]');
      if (labelEl) labelEl.textContent = words;
      var refEl = document.querySelector('[data-day-ref]');
      if (refEl) refEl.textContent = words;
      document.querySelectorAll('.sec-t').forEach(function (el) {
        if (el.textContent.indexOf('今天') === 0) el.textContent = el.textContent.replace(/^今天/, words);
      });

      // 提示只在「今天本该有新数据」时亮：休市日不提示，那天本来就不更新
      if (tradingMap[today] === 0) return;
      var nowHM = '12:00';
      try {
        nowHM = new Intl.DateTimeFormat('sv-SE', {
          timeZone: 'Asia/Shanghai', hour: '2-digit', minute: '2-digit', hour12: false,
        }).format(new Date());
      } catch (e) {}

      var hint = document.getElementById('stale-hint');
      var text = document.querySelector('[data-stale-text]');
      if (hint && text) {
        text.textContent = nowHM < '08:00'
          ? '今日数据预计 08:00 更新，当前展示 ' + zh + ' 的数据。'
          : '今日数据尚未更新，当前展示 ' + zh + ' 的数据。';
        hint.hidden = false;
      }
    })();
  </script>
</BaseLayout>
